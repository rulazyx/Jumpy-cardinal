{
  "name": "jumpy-cardinal",
  "version": "1.0.0",
  "private": true,
  "description": "Jumpy Cardinal, appli iOS / Android (Capacitor)",
  "scripts": {
    "serve": "npx serve www",
    "sync": "cap sync",
    "assets": "node tools/native-assets.cjs && capacitor-assets generate --ios --android --iconBackgroundColor '#9fdfff' --splashBackgroundColor '#7ad0ff'",
    "ios": "cap sync ios && cap open ios",
    "android": "cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0"
  }
}
