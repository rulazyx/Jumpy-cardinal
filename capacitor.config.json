{
  "appId": "fr.jumpycardinal.app",
  "appName": "Jumpy Cardinal",
  "webDir": "www",
  "backgroundColor": "#7ad0ff",
  "ios": { "contentInset": "never", "scrollEnabled": false },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 300, "launchAutoHide": true, "backgroundColor": "#7ad0ff", "showSpinner": false },
    "SystemBars": { "insetsHandling": "css", "initialViewportFitValueHint": "cover" }
  }
}
